# Copy to .env and fill in what you use. Everything here is optional while
# RAGPIPE_LLM__PROVIDER=mock (the default), which runs the whole pipeline
# offline and deterministically.
#
# .env is gitignored. Never commit a real key.

# --- OpenAI-compatible providers (pick whichever you have) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- other backends ---
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- selecting a provider ---
# Config overrides use a double-underscore nested delimiter:
#   RAGPIPE_LLM__PROVIDER=groq
#   RAGPIPE_LLM__MODEL=openai/gpt-oss-120b
#   RAGPIPE_RETRIEVAL__TOP_K=5
#
# Groq free tier is heavily rate limited (30 req/min, 8K tokens/min,
# 200K tokens/day). One evaluation sample is ~14k tokens, so a full
# 150-pair run is a multi-day proposition on the free tier -- the eval
# harness prints a feasibility estimate before it starts.
